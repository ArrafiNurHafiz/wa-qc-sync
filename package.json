{
  "name": "qc-kwas",
  "version": "1.1.1",
  "description": "WhatsApp & Web Field Quality Control automation to Google Drive & Sheets for CV Karya Wahana Sentosa",
  "main": "src/runtime/index.js",
  "bin": {
    "qc-kwas": "src/runtime/cli.js"
  },
  "type": "module",
  "files": [
    "src/",
    "public/",
    "gas/",
    "README.md",
    ".env.example",
    "docs/referensi/Form Lap QC Lap-cetak.xlsx",
    "docs/panduan/"
  ],
  "scripts": {
    "start": "node src/runtime/index.js",
    "web": "node src/runtime/web-only.js",
    "setup": "node src/runtime/cli.js setup",
    "doctor": "node src/runtime/cli.js doctor",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "baileys",
    "whatsapp-bot",
    "quality-control",
    "google-drive",
    "google-apps-script",
    "kwas"
  ],
  "author": "Arrafi Nur Hafiz",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArrafiNurHafiz/wa-qc-sync.git"
  },
  "homepage": "https://github.com/ArrafiNurHafiz/wa-qc-sync#readme",
  "bugs": {
    "url": "https://github.com/ArrafiNurHafiz/wa-qc-sync/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.19",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "fastest-levenshtein": "^1.0.16",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
