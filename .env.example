# Konfigurasi Lingkungan — Automasi QC Lapangan KWaS (wa-qc-sync)

# Port Web Command Center & Mobile QC Form (terpisah dari proyek wa di port 3000)
PORT=3001

# URL Web App Google Apps Script (hasil Deploy code gas/Code_QC.gs)
GAS_QC_WEBHOOK_URL=""

# Whitelist ID Grup WhatsApp yang diizinkan (pisahkan dengan koma, kosong = semua chat)
# Contoh: 120363xxx@g.us,120364xxx@g.us
ALLOWED_GROUPS=""

# Token rahasia opsional untuk mencocokkan payload ke GAS Script Properties (API_SECRET)
API_SECRET=""

# Mode Debug Baileys (true / false)
DEBUG=false
